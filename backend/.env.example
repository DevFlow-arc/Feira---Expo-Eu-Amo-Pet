# ───────────────────────────────────────────────
# Variáveis de Ambiente — Backend Feira Pet
# Copie este arquivo como .env e preencha os valores
# NUNCA commite o .env real (está no .gitignore)
# ───────────────────────────────────────────────

# Porta do servidor
PORT=3100

# Segredo JWT (use uma string longa e aleatória em produção)
JWT_SECRET=feira_pet_dev_secret_mude_em_producao

# Domínio do frontend para CORS (em desenvolvimento)
FRONTEND_ORIGIN=http://localhost:3002

# Credenciais iniciais do time (serão removidas após implementar DB)
# Formato: usuario:senha separados por ponto-e-vírgula para múltiplos usuários
# Exemplo: TEAM_USERS=maycon:minha_senha;andre:senha_andre
TEAM_USERS=
